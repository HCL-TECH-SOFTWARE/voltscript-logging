'{{Constants
Public Const NO_LOGGING = 0 	' Only used in LogWriters, to prevent logging any log entries.
Public Const LOG_TRACE = 1 	 	' Lowest logging level, for most verbose logging.
Public Const LOG_DEBUG = 2 	 	' Fifth-highest logging level, for more extensive messages than most support requires.
Public Const LOG_INFO = 4 	 	' Fourth-highest logging level, for informational messages.
Public Const LOG_WARN = 8 	 	' Third-highest logging level, for log entries that are not errors but should be addressed.
Public Const LOG_ERROR = 16 	' Second-highest logging level, for errors that are not fatal to continuing process.
Public Const LOG_FATAL = 32 	' Highest logging level.
'}}

'{{SETI_AUTHOR_CODE_VoltScriptLogging_Private_Constants
Private Const LIBRARY_NAME = "VoltscriptLogging"

Private Const ERR_FATAL_EXCEPTION = 			1000
Private Const MSG_FATAL_EXCEPTION = 			|A non-recoverable exception has occurred.  |

Private Const ERR_OPERATION_FAILED 	= 			1001
Private Const MSG_OPERATION_FAILED = 			|The requested operation could not be completed.  |

Private Const ERR_OPERATION_PROHIBITED = 		1003
Private Const MSG_OPERATION_PROHIBITED = 		|Operation Prohibited. |

Private Const ERR_PARAMETER_BLANK = 			1199
Private Const MSG_PARAMETER_BLANK = 			|A required parameter is blank or missing.  |

Private Const ERR_PARAMETER_INVALID = 			1195
Private Const MSG_PARAMETER_INVALID = 			|A passed parameter is invalid.  |

'}}

'{{Variables
Public globalLogSession As LogSession 	 ' Global Logging Session
'}}

'{{SETI_AUTHOR_CODE_VoltScriptLogging_Private_Variables
Private stcInstances as Long  
Private fromHere as Boolean 
'}}

'{{SETI_AUTHOR_CODE_VoltScriptLogging_Private_Types
Private Type libmethline 
	libraryName as String 
	methodName as String 
	linenum As Integer 
End Type 
'}}

'{{SETI_AUTHOR_CODE_VoltScriptLogging_Private_Properties


%REM
	Property NullValue 
	Voltscript representation of a NullValue (empty Variant)

	@return	Variant
%END REM
Static Private Property Get NullValue As Variant 
	Static result As Variant 
	Return result
End Property


%REM
	Property LF 
	VoltScript character for a line feed

	@return	String
%END REM
Static Private Property Get LF As String 
	Return Chr(10)
End Property


%REM
	Property HT 
	VoltScript character for a horizontal tab

	@return	String
%END REM
Static Private Property Get HT As String 
	Return Chr(9)
End Property

'}}



%REM
	Class BaseLogWriter 
	Abstract class for writing log entries from the LogSession
 
%END REM
Public Class BaseLogWriter 

	'{{SETI_AUTHOR_CODE_BaseLogWriter_Private_Variables
	Private label_ as String
	Private minLevel_ as Integer
	Private maxLevel_ as Integer
	Private formatter_ as String

	'}}


	%REM
		Property label 
		Label with which to refer to the log writer
	
		@return	String
	%END REM
	Public Property Get label As String 
		'{{SETI_AUTHOR_CODE_Get.label_implementation
		Return Me.label_
		'}}

	End Property


	%REM
		Property maxLevel 
		Level at which to log out
	
		@return	Integer
	%END REM
	Public Property Get maxLevel As Integer 
		'{{SETI_AUTHOR_CODE_Get.maxLevel_implementation
		Return Me.maxLevel_
		'}}

	End Property


	%REM
		Property formatter 
		String to manage output format, using mustache templating for properties of a Log Entry.
	
		@return	String
	%END REM
	Public Property Get formatter As String 
		'{{SETI_AUTHOR_CODE_Get.formatter_implementation
		Return Me.formatter_
		'}}

	End Property


	%REM
		Property minLevel 

		@return	Integer
	%END REM
	Public Property Get minLevel As Integer 
		'{{SETI_AUTHOR_CODE_Get.minLevel_implementation
		Return Me.minLevel_
		'}}

	End Property

	'{{SETI_AUTHOR_CODE_BaseLogWriter_Private_Properties
	'}}


	%REM
		Sub New 
		Constructor for the object.
	
		@param	label 	Name for the log writer, which will be the key when added to the session

		@param	minLevel 	Minimum level to log out

		@param	maxLevel 	Maximum level to log out

		@param	formatter 	A string format to log out, which can include mustache template format to inlcude LogEntry properties

	%END REM
	Public Sub New(label As String, minLevel As Integer, maxLevel As Integer, formatter As String) 
		'{{SETI_AUTHOR_CODE_New_implementation
		Me.label_ = label
		Me.minLevel_ = minLevel
		Me.maxLevel_ = maxLevel
		Me.formatter_ = formatter
		'}}

	End Sub


	%REM
		Sub Delete 
		Destructor for the class.  
Runs during cleanup of the object instance and outputs log entries
	
	%END REM
	Public Sub Delete() 
		'{{SETI_AUTHOR_CODE_Delete_implementation
			If (Not globalLogSession Is Nothing) Then
				If (IsElement(globalLogSession.logWriters(Me.label))) Then
					Call Me.writeToLog(globalLogSession)
				End If
			End If
		'}}

	End Sub


	%REM
		Sub terminateLog 
		Overload this method to do any setup after processing the LogEntry objects.  This method is called internally at the end of the writeToLog() method. 
	
	%END REM
	Public Sub terminateLog() 
		'{{SETI_AUTHOR_CODE_terminateLog_implementation
		'}}

	End Sub


	%REM
		Sub initializeLog 
		Overload this method to do any setup before processing the LogEntry objects.
	
	%END REM
	Public Sub initializeLog() 
		'{{SETI_AUTHOR_CODE_initializeLog_implementation
		'}}

	End Sub


	%REM
		Sub outputLogEntryMessage 
		Writes a message to the output.    Overload this message for specific implementations.
	
		@param	message 	Message to be outputted

	%END REM
	Public Sub outputLogEntryMessage(message As String) 
		'{{SETI_AUTHOR_CODE_outputLogEntryMessage_implementation
		Print message
		'}}

	End Sub


	%REM
		Function writeToLog 
		Write all entries, as appropriate, to the log
	
		@param	session 	Session from which to get the entries to be written

		@return	Boolean
	%END REM
	Public Function writeToLog(session As LogSession) As Boolean 
		'{{SETI_AUTHOR_CODE_writeToLog_implementation

		If (Me.maxLevel = NO_LOGGING) Then Return False

		Dim temp as LogEntry
		Dim filteredEntries as Variant
		Dim message as String
		Dim i as Long

		Try
			filteredEntries = session.getLogEntriesByLevel(Me.minLevel, Me.maxLevel)
			If (IsEmpty(filteredEntries)) Then Return False
			Call initializeLog()
			For i = 0 To Ubound(filteredEntries)
				Set temp = filteredEntries(i)
				message = convertLogEntryToMessage(temp)
				Call Me.outputLogEntryMessage(message)
			Next
			Return True
		Finally
			Call terminateLog()
		End Try
		'}}

	End Function


	%REM
		Function convertLogEntryToMessage 
		Generates a message using information from a logEntry instance and the object's formatter text (one of the constructor arguments).  Override this method to skip using the formatter.
	
		@param	logEntry 	Log Entry from which to generate the message.

		@return	String
		@throws	No Formatter 	"No formatter set for log writer " & Me.label

	%END REM
	Public Function convertLogEntryToMessage(logEntry As LogEntry) As String 
		'{{SETI_AUTHOR_CODE_convertLogEntryToMessage_implementation
		If (Me.formatter = "") Then
			Error 1000, "No formatter set for log writer " & Me.label
		Else
			Return getFormattedString(logEntry)
		End If
		'}}

	End Function

	'{{SETI_AUTHOR_CODE_BaseLogWriter_Private_Methods
	Private Function getFormattedString(logEntry as LogEntry) as String
		Dim key as String
		Dim outputStr as String
		Dim i as Long
		Dim propVal as Variant

		Try

		outputStr = Me.formatter
		If (outputStr != "") Then
			For i = 0 to UBound(getLogEntryPropertyNames())
				key = getLogEntryPropertyNames()(i)
				propVal = logEntry.getPropertyValue(key)
				outputStr = Replace(outputStr, |{{| & key & |}}|, CStr(propVal))
			Next
		End If
		Return outputStr
		Catch
			Error Err, Error() & " on line " & Erl()
		End Try
	End Function
	'}} 

End Class 


%REM
	Class ErrorEntity 
	Carrier for Error information.
 
%END REM
Public Class ErrorEntity 

	'{{SETI_AUTHOR_CODE_ErrorEntity_Private_Variables
	Private stackinfo_() as libmethline

	Private message_ as String
	Private timestamp_ as String
	Private classname_ as String
	Private uuid_ as String 
	Private stcInstance_ as Long 
	Private stackInstantiated_ As Boolean 

	Private code_ as Integer
	Private linenum_ as Integer 
	'}}


	%REM
		Property lineNum 
		Line number of the running code where the Error was triggered.  Overrides StackTraceCarrier.lineNum
	
		@return	Integer
	%END REM
	Public Property Get lineNum As Integer 
		'{{SETI_AUTHOR_CODE_Get.lineNum_implementation 
		return Me.linenum_
		'}}

	End Property


	%REM
		Property code 
		Error code of the error.
	
		@return	Integer
	%END REM
	Public Property Get code As Integer 
		'{{SETI_AUTHOR_CODE_Get.code_implementation
		Return Me.code_
		'}}

	End Property


	%REM
		Property entryID 
		A unique identifier for the object
	
		@return	String
	%END REM
	Public Property Get entryID As String 
		'{{SETI_AUTHOR_CODE_Get.entryID_implementation
		Return Me.libraryName & |.| & Me.uuid_
		'}}

	End Property


	%REM
		Property stackTrace 
		Stack Trace of the object creation, delimited by LF, in the format of "libraryName, methodName, linenum" for each line in the stack trace.
	
		@return	String
	%END REM
	Public Property Get stackTrace As String 
		'{{SETI_AUTHOR_CODE_Get.stackTrace_implementation
		Dim i as Integer 
		Dim trace() as String 

		Redim trace(Ubound(Me.stackinfo_)) As String	

		For i = 0 To Ubound(Me.stackinfo_) 
			trace(i) = Me.stackinfo_(i).libraryName & |,| & Me.stackinfo_(i).methodName & |,| & cstr(Me.stackinfo_(i).linenum)
		Next 

		Return Join(trace, LF) 
		'}}

	End Property


	%REM
		Property uuID 
		Unique identifier for the instance
	
		@return	String
	%END REM
	Public Property Get uuID As String 
		'{{SETI_AUTHOR_CODE_Get.uuID_implementation
			return Me.uuid_ 
		'}}

	End Property


	%REM
		Property message 
		The text message of the object (passed as an argument to the object's constructor).
	
		@return	String
	%END REM
	Public Property Get message As String 
		'{{SETI_AUTHOR_CODE_Get.message_implementation
		Return Me.message_
		'}}

	End Property


	%REM
		Property className 
		VoltScript class from which the the object creation was triggered (passed into the constructor). 
	
		@return	String
	%END REM
	Public Property Get className As String 
		'{{SETI_AUTHOR_CODE_Get.className_implementation
		Return Me.classname_
		'}}

	End Property


	%REM
		Property libraryName 
		Name of the VSS library where the object creation was triggered. 
	
		@return	String
	%END REM
	Public Property Get libraryName As String 
		'{{SETI_AUTHOR_CODE_Get.libraryName_implementation
		Return Me.stackinfo_(0).libraryName
		'}}

	End Property


	%REM
		Property methodName 
		Name of the method (Property, Event, Sub, or Function) where the object creation was triggered. 
	
		@return	String
	%END REM
	Public Property Get methodName As String 
		'{{SETI_AUTHOR_CODE_Get.methodName_implementation
		Return Me.stackinfo_(0).methodName
		'}}

	End Property


	%REM
		Property timeStamp 
		Timestamp of when the object instance was created. This is date/time in yyyy-MM-dd hh:mm:ss format in the current platform's timezone.
	
		@return	String
	%END REM
	Public Property Get timeStamp As String 
		'{{SETI_AUTHOR_CODE_Get.timeStamp_implementation
		Return Me.timestamp_
		'}}

	End Property


	%REM
		Property instanceNumber 
		Instance Number (relative to all other StackTraceCarrier objects in the current session) 
	
		@return	Long
	%END REM
	Public Property Get instanceNumber As Long 
		'{{SETI_AUTHOR_CODE_Get.instanceNumber_implementation
		Return Me.stcInstance_ 
		'}}

	End Property

	'{{SETI_AUTHOR_CODE_ErrorEntity_Private_Properties
    Private Property Get CLASS_NAME As String 
        Return "ErrorEntity"
    End Property 
	'}}


	%REM
		Sub New 
		Constructor
	
		@param	className 	Class where the object creation was triggered.  Blank if not within a class. 

	%END REM
	Public Sub New(className As String)
		'{{SETI_AUTHOR_CODE_New_implementation
		Dim stackarray as Variant 
		Dim linearray as Variant 

		Dim lml as libmethline

		Dim i as Integer 
		Dim inConstructor as Boolean 


		' BEGIN CODE 
		Redim Me.stackinfo_(0) As libmethline
		Me.stcInstance_ = stcInstances++
		Me.classname_ = FullTrim(classname)
		Me.message_ = Error$() 
		Me.timestamp_ = Format(Now(), "yyyy-MM-dd hh:mm:ss")
		Me.uuid_ = CreateUuid()


		' getThreadInfo(12) includes a trailing LF
		' LF is delimiter on Windows, is standard delimiter on Linux
		stackarray = split(FullTrim(getThreadInfo(12)), LF)

		' add content from the stack trace to the internal stack, 
		' but skip the current constructor, direct parent constructors, and ErrorSession / LogSession creators. 
		inConstructor = True 
		For i = 1 to Ubound(stackarray) ' start at ordinal position 1 to skip this constructor 

			linearray = Split(stackarray(i), |,|) 
			Select Case Ubound(linearray) 
				Case 0 
					' This can happen when a an error occurs in an Execute statement. 
					lml.linenum = cint(linearray(0))

				Case 1 
					' This can happen when a an error occurs in an Execute statement. 
					lml.methodName = linearray(0) 
					lml.linenum = cint(linearray(1))

				Case Else 
					lml.libraryName = linearray(0) 
					lml.methodName = linearray(1)
					lml.linenum = cint(linearray(2))

					If inConstructor Then inConstructor = (0 = strComp(lml.methodName, |New|, 5)) 

					If inConstructor Then
						' skip the constructor direct parent constructors. 
					Else
						Select Case i 
							Case 1, 2
								If ((0 = strComp(lml.libraryName, |VoltScriptLogging|, 5)) _  
								&& (0 = strComp(lml.methodName, |addError|, 5)) _ 
								|| (0 = strComp(lml.methodName, |createLogEntry|, 5))) Then 
									' skip the ErrorSession / LogSession creators.
								Else 
									Call Me.pushlml(lml)
								End If

							Case Else 
								Call Me.pushlml(lml)

						End Select
					End If 
			End Select 
		Next  

		Me.lineNum_ = Erl()
		Me.code_ = Err()
		'}}

	End Sub


	%REM
		Sub printSummary 
		Outputs a summary of the object's property information to console. Only relevant for basic debugging.
	
	%END REM
	Public Sub printSummary() 
		'{{SETI_AUTHOR_CODE_printSummary_implementation
		Print Me.CLASS_NAME & |.code : | & cstr(Me.code)

		Dim stackinfo as Variant 
		Dim i as Integer 

		Print Me.CLASS_NAME & |.instanceNumber: | & Me.instanceNumber 
		Print Me.CLASS_NAME & |.entryID: | & Me.entryID 
		Print Me.CLASS_NAME & |.timestamp : | & Me.timestamp 
		Print Me.CLASS_NAME & |.libraryName : | & Me.libraryName 
		Print Me.CLASS_NAME & |.className : | & Me.className
		Print Me.CLASS_NAME & |.methodName : | & Me.methodName 
		Print Me.CLASS_NAME & |.linenum : | & cstr(Me.linenum)
		Print Me.CLASS_NAME & |.message : | & Me.message 
		Print Me.CLASS_NAME & |.StackTrace: |
		stackinfo = Fulltrim(split(Me.StackTrace, LF))

		For i = Lbound(stackinfo) To Ubound(stackinfo) 
			Print HT & |(| & cstr(i) & |): | & stackinfo(i)
		Next 
		Print || 
	'}}

	End Sub


	%REM
		Function getLogMessage 
		Summary information about the Error to be included when creating a LogEvent. 
	
		@return	String
	%END REM
	Public Function getLogMessage() As String 
		'{{SETI_AUTHOR_CODE_getLogMessage_implementation
		Return |Error | & Me.code & |, | & Me.message & | at line | & Me.lineNum
		'}}

	End Function

	'{{SETI_AUTHOR_CODE_ErrorEntity_Private_Methods

	%REM
		Sub pushlml 
		Pushes a libmethline onto the internal stack. 

	%END REM
	Sub pushlml(lml as libmethline)
		If Me.stackInstantiated_ Then 
			Redim Preserve Me.stackinfo_(Ubound(Me.stackinfo_) + 1) As libmethline 
		Else 
			Me.stackInstantiated_ = True 
			Redim Me.stackinfo_(0) As libmethline 
		End If 

		Me.stackinfo_(Ubound(Me.stackinfo_)) = lml 
	End Sub 

	'}} 

End Class 


%REM
	Class ErrorSession 
	Stack Collection of ErrorEntity objects. 
 
%END REM
Public Class ErrorSession 

	'{{SETI_AUTHOR_CODE_ErrorSession_Private_Variables
	Private content_ as Variant ' Variant array to hold specialized content of the object 
	Private index_ As Integer 
	'}}


	%REM
		Property errorCount 
		Count of errors currently contained in the ErrorSession. 
	
		@return	Integer
	%END REM
	Public Property Get errorCount As Integer 
		'{{SETI_AUTHOR_CODE_Get.errorCount_implementation
		If (IsEmpty(Me.content_)) Then
			Return 0
		Else
			Return Ubound(Me.content_) + 1
		End If
		'}}

	End Property


	%REM
		Property errors 
		All ErrorEntity instances that have been added to the object.
	
		@return	Variant
	%END REM
	Public Property Get errors As Variant 
		'{{SETI_AUTHOR_CODE_Get.errors_implementation 
		Return Me.content_
		'}}

	End Property

	'{{SETI_AUTHOR_CODE_ErrorSession_Private_Properties
	%REM
		Property isEmpty 
		Flag indicating if the object contains no LogEntries (entryCount = 0) 

		@return	Boolean
	%END REM
	Private Property Get isEmpty As Boolean 
		Return isEmpty(Me.content_)
	End Property

	'}}


	%REM
		Sub New 
		Constructor for the object.  Can only be used when called from method getErrorSession() 
Do not directly use this constructor, use getErrorSession() instead.
	
		@throws	Operation Prohibited 	Use getErrorSession() to get the ErrorSession. 

	%END REM
	Public Sub New() 
		'{{SETI_AUTHOR_CODE_New_implementation
		If Not fromHere Then Error ERR_OPERATION_PROHIBITED, MSG_OPERATION_PROHIBITED & |Use getErrorSession() to create a new ErrorSession object.|
		'}}

	End Sub


	%REM
		Sub reset 
		Resets the ErrorSession and clears all error information. 
	
	%END REM
	Public Sub reset() 
		'{{SETI_AUTHOR_CODE_reset_implementation
		Me.content_ = NullValue
		Me.index_ = 0
		'}}

	End Sub


	%REM
		Function addError 
		Spawns a new ErrorEntity object and adds it to the ErrorSession
	
		@param	className 	Class where the object creation was triggered. Blank if not within a class.  (Passed to the ErrorEntity constructor)

		@return	ErrorEntity
	%END REM
	Public Function addError(className As String) As ErrorEntity 
		'{{SETI_AUTHOR_CODE_addError_implementation

		Dim temp as New ErrorEntity(className)

		If (IsEmpty(Me.content_)) Then
			Redim Me.content_(0) As ErrorEntity
		Else
			Redim Preserve Me.content_(Ubound(Me.content_) + 1) As ErrorEntity
		End If

		Set Me.content_(Ubound(Me.content_)) = temp

		Return temp
		'}}

	End Function

	'{{SETI_AUTHOR_CODE_ErrorSession_Private_Methods
	'}} 

End Class 


%REM
	Class LogEntry 
	Represents a single Log Entry in the LogSession
 
%END REM
Public Class LogEntry 

	'{{SETI_AUTHOR_CODE_LogEntry_Private_Variables
	Private stackinfo_() as libmethline

	Private message_ as String
	Private timestamp_ as String
	Private classname_ as String
	Private uuid_ as String 
	Private stcInstance_ as Long 
	Private stackInstantiated_ As Boolean 
	Private extinfo_ as String
	Private level_ as Integer
	'}}


	%REM
		Property level 
		The logging level assigned to the object.  Specified as an argument in the object's constructor. 
	
		@return	Integer
	%END REM
	Public Property Get level As Integer 
		'{{SETI_AUTHOR_CODE_Get.level_implementation
		Return Me.level_
		'}}

	End Property


	%REM
		Property extInfo 
		Extended info that may be included with the message, such as debug info, stack trace, etc.  Set in the object's constructor. 
	
		@return	String
	%END REM
	Public Property Get extInfo As String 
		'{{SETI_AUTHOR_CODE_Get.extInfo_implementation
		Return Me.extInfo_
		'}}	

	End Property


	%REM
		Property levelName 
		Name of the logging level for the object.
	
		@return	String
	%END REM
	Public Property Get levelName As String 
		'{{SETI_AUTHOR_CODE_Get.levelName_implementation
		Select Case Me.level_
			Case 0:
				Return "NO_LOGGING"
			Case 1:
				Return "TRACE"
			Case 2:
				Return "DEBUG"
			Case 4:
				Return "INFO"
			Case 8:
				Return "WARN"
			Case 16:
				Return "ERROR"
			Case 32:
				Return "FATAL"
			Case Else:
				Return ""
		End Select
		'}}

	End Property


	%REM
		Property entryID 
		A unique identifier for the object
	
		@return	String
	%END REM
	Public Property Get entryID As String 
		'{{SETI_AUTHOR_CODE_Get.entryID_implementation
		Return Me.libraryName & |.| & Me.uuid_
		'}}

	End Property


	%REM
		Property stackTrace 
		Stack Trace of the object creation, delimited by LF, in the format of "libraryName, methodName, linenum" for each line in the stack trace.
	
		@return	String
	%END REM
	Public Property Get stackTrace As String 
		'{{SETI_AUTHOR_CODE_Get.stackTrace_implementation
		Dim i as Integer 
		Dim trace() as String 

		Redim trace(Ubound(Me.stackinfo_)) As String	

		For i = 0 To Ubound(Me.stackinfo_) 
			trace(i) = Me.stackinfo_(i).libraryName & |,| & Me.stackinfo_(i).methodName & |,| & cstr(Me.stackinfo_(i).linenum)
		Next 

		Return Join(trace, LF) 
		'}}

	End Property


	%REM
		Property uuID 
		Unique identifier for the instance
	
		@return	String
	%END REM
	Public Property Get uuID As String 
		'{{SETI_AUTHOR_CODE_Get.uuID_implementation
			return Me.uuid_ 
		'}}

	End Property


	%REM
		Property message 
		The text message of the object (passed as an argument to the object's constructor).
	
		@return	String
	%END REM
	Public Property Get message As String 
		'{{SETI_AUTHOR_CODE_Get.message_implementation
		Return Me.message_
		'}}

	End Property


	%REM
		Property className 
		VoltScript class from which the the object creation was triggered (passed into the constructor). 
	
		@return	String
	%END REM
	Public Property Get className As String 
		'{{SETI_AUTHOR_CODE_Get.className_implementation
		Return Me.classname_
		'}}

	End Property


	%REM
		Property lineNum 
		Line number of the running code where the object creation was triggered. 
	
		@return	Integer
	%END REM
	Public Property Get lineNum As Integer 
		'{{SETI_AUTHOR_CODE_Get.lineNum_implementation
		Return Me.stackinfo_(0).linenum
		'}}

	End Property


	%REM
		Property libraryName 
		Name of the VSS library where the object creation was triggered. 
	
		@return	String
	%END REM
	Public Property Get libraryName As String 
		'{{SETI_AUTHOR_CODE_Get.libraryName_implementation
		Return Me.stackinfo_(0).libraryName
		'}}

	End Property


	%REM
		Property methodName 
		Name of the method (Property, Event, Sub, or Function) where the object creation was triggered. 
	
		@return	String
	%END REM
	Public Property Get methodName As String 
		'{{SETI_AUTHOR_CODE_Get.methodName_implementation
		Return Me.stackinfo_(0).methodName
		'}}

	End Property


	%REM
		Property timeStamp 
		Timestamp of when the object instance was created. This is date/time in yyyy-MM-dd hh:mm:ss format in the current platform's timezone.
	
		@return	String
	%END REM
	Public Property Get timeStamp As String 
		'{{SETI_AUTHOR_CODE_Get.timeStamp_implementation
		Return Me.timestamp_
		'}}

	End Property


	%REM
		Property instanceNumber 
		Instance Number (relative to all other StackTraceCarrier objects in the current session) 
	
		@return	Long
	%END REM
	Public Property Get instanceNumber As Long 
		'{{SETI_AUTHOR_CODE_Get.instanceNumber_implementation
		Return Me.stcInstance_ 
		'}}

	End Property

	'{{SETI_AUTHOR_CODE_LogEntry_Private_Properties
    Private Property Get CLASS_NAME As String 
        Return "LogEntry"
    End Property 
	'}}


	%REM
		Sub New 
		Constructor
	
		@param	levelNum 	Level for the LogEntry, restricted to the LOG_xxx constants

		@param	message 	A short message to log

		@param	extInfo 	Extended information to log

		@param	className 	Class where the object creation was triggered. Blank if not within a class. 

		@throws	Invalid logging level 	Invalid logging level: + levelNum. Use one of the LOG_... constants

	%END REM
	Public Sub New(levelNum As Integer, message As String, extInfo As String, className As String) 
		'{{SETI_AUTHOR_CODE_New_implementation
		Dim stackarray as Variant 
		Dim linearray as Variant 

		Dim lml as libmethline

		Dim i as Integer 
		Dim inConstructor as Boolean 


		' BEGIN CODE 
		Redim Me.stackinfo_(0) As libmethline
		Me.stcInstance_ = stcInstances++
		Me.classname_ = FullTrim(classname)
		Me.message_ = message 
		Me.timestamp_ = Format(Now(), "yyyy-MM-dd hh:mm:ss")
		Me.uuid_ = CreateUuid()


		' getThreadInfo(12) includes a trailing LF
		' LF is delimiter on Windows, is standard delimiter on Linux
		stackarray = split(FullTrim(getThreadInfo(12)), LF)

		' add content from the stack trace to the internal stack, 
		' but skip the current constructor, direct parent constructors, and ErrorSession / LogSession creators. 
		inConstructor = True 
		For i = 1 to Ubound(stackarray) ' start at ordinal position 1 to skip this constructor 

			linearray = Split(stackarray(i), |,|) 
			Select Case Ubound(linearray) 
				Case 0 
					' This can happen when a an error occurs in an Execute statement. 
					lml.linenum = cint(linearray(0))

				Case 1 
					' This can happen when a an error occurs in an Execute statement. 
					lml.methodName = linearray(0) 
					lml.linenum = cint(linearray(1))

				Case Else 
					lml.libraryName = linearray(0) 
					lml.methodName = linearray(1)
					lml.linenum = cint(linearray(2))

					If inConstructor Then inConstructor = (0 = strComp(lml.methodName, |New|, 5)) 

					If inConstructor Then
						' skip the constructor direct parent constructors. 
					Else
						Select Case i 
							Case 1, 2
								If ((0 = strComp(lml.libraryName, |VoltScriptLogging|, 5)) _  
								&& (0 = strComp(lml.methodName, |addError|, 5)) _ 
								|| (0 = strComp(lml.methodName, |createLogEntry|, 5))) Then 
									' skip the ErrorSession / LogSession creators.
								Else 
									Call Me.pushlml(lml)
								End If

							Case Else 
								Call Me.pushlml(lml)

						End Select
					End If 
			End Select 
		Next  

		' Fail in invalid level 
		If Not isValidLevel(levelNum, False) Then Error ERR_PARAMETER_INVALID, MSG_PARAMETER_INVALID & "Invalid logging level: " & CStr(levelNum) & ". Use one of the LOG_... constants"

		Me.level_ = levelNum
		Me.extInfo_ = extInfo
		'}}

	End Sub


	%REM
		Sub printSummary 
		Outputs a summary of the properties of the LogEntry to console. Only relevant for basic debugging.
	
	%END REM
	Public Sub printSummary() 
		'{{SETI_AUTHOR_CODE_printSummary_implementation
		Print Me.CLASS_NAME & |.level : | & cstr(Me.level) 
		Print Me.CLASS_NAME & |.levelName : | & Me.levelName
		Print Me.CLASS_NAME & |.extInfo : | & Me.extInfo 

		Dim stackinfo as Variant 
		Dim i as Integer 

		Print Me.CLASS_NAME & |.instanceNumber: | & Me.instanceNumber 
		Print Me.CLASS_NAME & |.entryID: | & Me.entryID 
		Print Me.CLASS_NAME & |.timestamp : | & Me.timestamp 
		Print Me.CLASS_NAME & |.libraryName : | & Me.libraryName 
		Print Me.CLASS_NAME & |.className : | & Me.className
		Print Me.CLASS_NAME & |.methodName : | & Me.methodName 
		Print Me.CLASS_NAME & |.linenum : | & cstr(Me.linenum)
		Print Me.CLASS_NAME & |.message : | & Me.message 
		Print Me.CLASS_NAME & |.StackTrace: |
		stackinfo = Fulltrim(split(Me.StackTrace, LF))

		For i = Lbound(stackinfo) To Ubound(stackinfo) 
			Print HT & |(| & cstr(i) & |): | & stackinfo(i)
		Next 
		Print || 
		'}}

	End Sub


	%REM
		Function getPropertyValue 
		Retrieves a property value for a specified property name
	
		@param	propertyName 	Name of the property to be retrieved

		@return	Variant
		@throws	A passed parameter is invalid. 	property name invalid

	%END REM
	Public Function getPropertyValue(propertyName As String) As Variant 
	'{{SETI_AUTHOR_CODE_getPropertyValue_implementation

	Select Case propertyName
		Case "STACKTRACE":
			Return Me.stackTrace
		Case "LEVELNAME":
			Return Me.levelName
		Case "ENTRYID":
			Return Me.entryID
		Case "LEVEL":
			Return Me.level
		Case "MESSAGE":
			Return Me.message
		Case "CLASSNAME":
			Return Me.className
		Case "LINENUM":
			Return Me.lineNum
		Case "LIBRARYNAME":
			Return Me.libraryName
		Case "METHODNAME":
			Return Me.methodName
		Case "TIMESTAMP":
			Return Me.timestamp
		Case "EXTINFO"
			Return Me.extInfo
		Case "INSTANCENUMBER"
			Return Me.instanceNumber
		Case Else
			Error ERR_PARAMETER_INVALID, MSG_PARAMETER_INVALID & |propertyName: | & propertyName
	End Select
	'}}

	End Function

	'{{SETI_AUTHOR_CODE_LogEntry_Private_Methods

	%REM
		Sub pushlml 
		Pushes a libmethline onto the internal stack. 

	%END REM
	Sub pushlml(lml as libmethline)
		If Me.stackInstantiated_ Then 
			Redim Preserve Me.stackinfo_(Ubound(Me.stackinfo_) + 1) As libmethline 
		Else 
			Me.stackInstantiated_ = True 
			Redim Me.stackinfo_(0) As libmethline 
		End If 

		Me.stackinfo_(Ubound(Me.stackinfo_)) = lml 
	End Sub 

	'}} 

End Class 


%REM
	Class LogSession 
	Base class for VoltScript logging
 
%END REM
Public Class LogSession 

	'{{Variables
	Public logWriters List As BaseLogWriter 	 ' BaseLogWriters or classes extending BaseLogWriter.  ListTag is writer label.
	'}}

	'{{SETI_AUTHOR_CODE_LogSession_Private_Variables
	Private content_ as Variant ' Variant array to hold specialized content of the object 
	Private sessionid_ as String
	Private index_ As Integer 

	'}}


	%REM
		Property sessionID 
		unique ID/key for this logging session
	
		@return	String
	%END REM
	Public Property Get sessionID As String 
		'{{SETI_AUTHOR_CODE_Get.sessionID_implementation
		return Me.sessionid_
		'}}

	End Property


	%REM
		Property entryCount 
		Number of LogEntries contained by the LogSession
	
		@return	Integer
	%END REM
	Public Property Get entryCount As Integer 
		'{{SETI_AUTHOR_CODE_Get.entryCount_implementation
		If Not Me.isEmpty Then Return Ubound(Me.content_) + 1
		'}}

	End Property


	%REM
		Property entryIDs 
		Array of entryIDs for all LogEntry instances contained within the object.   If no LogEntry instances exist, returns a single element array containing an empty string. 
	
		@return	Variant
	%END REM
	Public Property Get entryIDs As Variant 
		'{{SETI_AUTHOR_CODE_Get.entryIDs_implementation
		Dim result() As String 
		Dim i as Integer 

		Redim result(Me.entryCount) As String

		If Not Me.isEmpty Then
			For i = 0 To Ubound(Me.content_)
				result(i) = Me.content_(i).entryID
			Next
		End If

		Return result

		'}}

	End Property


	%REM
		Property lastEntry 
		The most recently created LogEntry instance carried by the object. 
	
		@return	LogEntry
	%END REM
	Public Property Get lastEntry As LogEntry 
		'{{SETI_AUTHOR_CODE_Get.lastEntry_implementation
		If Not Me.isEmpty Then Return Me.content_(Ubound(Me.content_))
		'}}

	End Property

	'{{SETI_AUTHOR_CODE_LogSession_Private_Properties
	%REM
		Property isEmpty 
		Flag indicating if the object contains no LogEntries (entryCount = 0) 

		@return	Boolean
	%END REM
	Private Property Get isEmpty As Boolean 
		Return isEmpty(Me.content_)
	End Property
	'}}


	%REM
		Sub Delete 
		Destructor, during which LogWriters are processed
	
	%END REM
	Public Sub Delete() 
		'{{SETI_AUTHOR_CODE_Delete_implementation
		ForAll writer in Me.logWriters
			If Not writer is Nothing Then
				Call writer.writeToLog(Me)
			End If
		End ForAll
		'}}

	End Sub


	%REM
		Sub New 
		Constructor. Can only be used from getLogSession(). Do not use this constructor, use getLogSession() instead.
	
		@throws	Operation Prohibited 	Use getLogSession() to create a new LogSession object

	%END REM
	Public Sub New() 
		'{{SETI_AUTHOR_CODE_New_implementation
		If Not fromHere Then Error ERR_OPERATION_PROHIBITED, MSG_OPERATION_PROHIBITED & |Use globalLogSession to get the LogSession object.  |
		Me.sessionid_ = CreateUUID()
		'}}	

	End Sub


	%REM
		Sub addLogWriter 
		Adds a log writer to the object. 
	
		@param	logWriter 	Instance of BaseLogWriter or derived class

	%END REM
	Public Sub addLogWriter(logWriter As BaseLogWriter) 
		'{{SETI_AUTHOR_CODE_addLogWriter_implementation
		Set Me.logWriters(logWriter.label) = logWriter
		'}}

	End Sub


	%REM
		Sub reset 
		Deletes the LogSession without writing out entries
	
	%END REM
	Public Sub reset() 
		'{{SETI_AUTHOR_CODE_reset_implementation
		Me.content_ = NullValue
		Erase Me.LogWriters
		Me.index_ = 0
		Me.sessionid_ = getThreadInfo(11) & "_" & CreateUUID()
		'}}

	End Sub


	%REM
		Function getLogEntriesByLevel 
		Filters the LogEntry objects into an array containing just those at or above the minimum level and also at or below the maximum level.
	
		@param	minLevel 	Minimum level of logs to retrieve

		@param	maxLevel 	Maximum level of the logs to retrieve

		@return	Variant
	%END REM
	Public Function getLogEntriesByLevel(minLevel As Integer, maxLevel As Integer) As Variant 
		'{{SETI_AUTHOR_CODE_getLogEntriesByLevel_implementation
		Dim le as LogEntry
		Dim returnVal as Variant
		Dim i as Integer

		If Not Me.isEmpty Then 
			Forall element in Me.content_ 
				Set le = element 
				If (le.level >= minLevel And le.level <= maxLevel) Then
					If (IsEmpty(returnVal)) Then
						Redim returnVal(0)
						Set returnVal(0) = le
					Else
						Redim Preserve returnVal(Ubound(returnVal) + 1)
						Set returnVal(Ubound(returnVal)) = le
					End If
				End If
			End Forall	
		End If 

		Return returnVal
		'}}	

	End Function


	%REM
		Function createLogEntry 
		Creates a new LogEntry object. 
	
		@param	levelNum 	the Logging Level of the entry; you can use the constant as well

		@param	message 	the text message of the entry

		@param	extInfo 	Any extended information to include with the entry or blank

		@param	className 	Class from which the entry is logged or blank

		@return	LogEntry
	%END REM
	Public Function createLogEntry(levelNum As Integer, message As String, extInfo As String, className As String) As LogEntry 
		'{{SETI_AUTHOR_CODE_createLogEntry_implementation
		If Me.isEmpty Then
			Redim Me.content_(0) As LogEntry
		Else
			Redim Preserve Me.content_(Ubound(Me.content_) + 1) As LogEntry
		End If

		Set Me.content_(Ubound(Me.content_)) = New LogEntry(levelNum, message, extInfo, className) 
		Return Me.lastEntry

		'}}

	End Function


	%REM
		Function getLogEntryByID 
		Retrieves the LogEntry with a specified ID.  Nothing if not found. 
	
		@param	entryID 	the entryID of the desired log entry

		@return	LogEntry
	%END REM
	Public Function getLogEntryByID(entryID As String) As LogEntry 
		'{{SETI_AUTHOR_CODE_getLogEntryByID_implementation
		Dim result as LogEntry

		If ("" != entryID) && Not Me.isEmpty Then
			Forall element in Me.content_ 
				Set result = element 
				If (result.entryID = entryID) Then Return result
			End Forall
		End If
		'}}

	End Function

	'{{SETI_AUTHOR_CODE_LogSession_Private_Methods
	'}} 

End Class 
'{{SETI_AUTHOR_CODE_VoltscriptLogging_Private_Classes
'}}


%REM
	Function getErrorSession 
	Gets the ErrorSession 
	
	@return	ErrorSession
%END REM
Public Function getErrorSession() As ErrorSession 
	'{{SETI_AUTHOR_CODE_getErrorSession_implementation
    Static result as ErrorSession
    If (result is Nothing) Then
		fromHere = True
		Set result = New ErrorSession()
		fromHere = False
	End If
	return result 
	'}}

End Function


%REM
	Function getLogEntryPropertyNames 
	Gets the Property Names of the LogEntry Class
	
	@return	Variant
%END REM
Static Public Function getLogEntryPropertyNames() As Variant 
	'{{SETI_AUTHOR_CODE_getLogEntryPropertyNames_implementation
	Static props(11) as String

	If (props(0) = "") Then
		props(0) = "STACKTRACE"
		props(1) = "LEVELNAME"
		props(2) = "ENTRYID"
		props(3) = "LEVEL"
		props(4) = "MESSAGE"
		props(5) = "CLASSNAME"
		props(6) = "LINENUM"
		props(7) = "LIBRARYNAME"
		props(8) = "METHODNAME"
		props(9) = "TIMESTAMP"
		props(10) = "EXTINFO"
		props(11) = "INSTANCENUMBER"
	End If

	Return props
	'}}

End Function

'{{SETI_AUTHOR_CODE_VoltScriptLogging_Private_Methods
Private Function isValidLevel(levelNum as Integer, includeNoLogging as Boolean) as Boolean
	If (includeNoLogging && levelNum = NO_LOGGING) Then Return True
	Return (levelNum = LOG_FATAL) || (levelNum = LOG_ERROR) || (levelNum = LOG_WARN) || (levelNum = LOG_INFO) || (levelNum = LOG_DEBUG) || (levelNum = LOG_TRACE)
End Function

Sub Initialize
	fromHere = True
	Set globalLogSession = New LogSession()
	fromHere = False
End Sub
'}} 
