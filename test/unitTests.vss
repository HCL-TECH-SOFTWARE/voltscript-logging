Option Declare
Option Public

Use "../src/VoltScriptLogging"
Use "../libs/VoltScriptTesting"

Private localColl() as String
Private TEST_DELETE as Boolean

' NOTE: UPDATE THESE ERROR LINES IF ERROR TESTS MOVE 
Const errLine = 177    
Const BaseErrorTesterLine =  65
Const ChildErrorTesterLine_1 = 84
Const ChildErrorTesterLine_2 = 90
Const ChildErrorTesterLine_3 = 96 

Const ERR_1100 = 1100 
Const ERR_1400 = 1400 
Const ERR_1600 = 1600 
Const ERR_1800 = 1800 
Const ERR_2100 = 2100 

Const MSG_1100 = |This is the message for error 1100.|   
Const MSG_1400 = |This is the message for error 1400.|   
Const MSG_1600 = |This is the message for error 1600.|   
Const MSG_1800 = |This is the message for error 1800.|   
Const MSG_2100 = |This is the message for error 2100.|   



Class TestLogWriter as BaseLogWriter
    Public outputColl as Variant

    Public Function TestLogEntryFormat(logEntry as LogEntry) as String
        Return Me.getFormattedString(logEntry)
    End Function

    Sub New(label as String, minLevel as Integer, maxLevel as Integer, formatter as String)
        Redim localColl(0)
        Redim outputColl(0)
    End Sub
    
	Public Sub outputLogEntryMessage(message as String)
        If (TEST_DELETE) Then
            If (localColl(0) != "") Then Redim Preserve localColl(UBound(localColl) + 1)
            localColl(UBound(localColl)) = message
        Else
            If (outputColl(0) != "") Then Redim Preserve outputColl(UBound(outputColl) + 1)
            outputColl(UBound(outputColl)) = message
        End If
    End Sub

End Class


Class BaseErrorTester 

    Public Sub New() 

    End Sub 

    
    Public Sub TryCatchError(errCode As Integer, errMsg As String)
        Try 
            Error errCode, errMsg ' BaseErrorTesterLine   ' This is the ErrorEntry LineNum, and the LogEntry CalleeLineNum
        Catch 
            Call getErrorSession().createErrorEntry(LOG_ERROR)   ' This is the LogEntry LineNum. 
        End Try 
    End Sub 

End Class 


Class ChildErrorTester As BaseErrorTester

   Public Sub New() 

    End Sub

    
    Public Sub TryCatchError(errCode As Integer, errMsg As String)
        Try 
            If (errCode < 1300) Then 
                Error errCode, errMsg   ' ChildErrorTesterLine_1

            Elseif (errCode < 1500) Then 
                Call BaseErrorTester..TryCatchError(errCode, errMsg)

            Elseif (errCode < 1700) Then 
                Error errCode, errMsg   ' ChildErrorTesterLine_2

            Elseif (errCode < 1900) Then 
                Call BaseErrorTester..TryCatchError(errCode, errMsg)

            Else
                Error errCode, errMsg   ' ChildErrorTesterLine_3
            End If 

        Catch 
            Call getErrorSession().createErrorEntry(LOG_ERROR)
        End Try 

    End Sub 

End Class 


Sub Initialize

    Dim tot as Integer
    Dim totExp as Integer
    Dim lastResult as Boolean
    Dim result as Boolean
    Dim testRunner as New TestRunner("Logging Tests")
    Call testRunner.setOutputFormat("BOTH")

    Try
        totExp = 127
        result = runSessionTests(testRunner)
        If result Then tot += 1
        
        lastResult = logEntryTests(testRunner)
        If lastResult Then tot += 2
        result = result And lastResult
        
        lastResult = logCollectionTests(testRunner)
        If lastResult Then tot += 4
        result = result And lastResult
        
        lastResult = logFunctionTests(testRunner)
        If lastResult Then tot += 8
        result = result And lastResult
        
        lastResult = runBaseWriterTests(testRunner)
        If lastResult Then tot += 16
        result = result And lastResult
        
        lastResult = testErrors(testRunner)
        If lastResult Then tot += 32
        result = result And lastResult

        lastResult = testClassHierarchyErrors(testRunner)
        If lastResult Then tot += 64
        result = result And lastResult

        lastResult = testSpawnedLogEntryProperties(testRunner)
        If lastResult Then tot += 128
        result = result And lastResult

        

        If result Then
            Print ""
            Print "All tests ran successfully"
        Else
            Error 1001, "Tests Failed, tot was " & tot & ", expected " & totExp & ". Check results"
        End If
    Catch
        Error 1001, "Error " & Error() & " on line " & Erl()
    End Try

End Sub


Function testErrors(testRunner as TestRunner) as Boolean

    Dim testSuite as New TestSuite("Error Tests")
    Call testRunner.addTestSuite(testSuite)

    Dim errObj as ErrorEntry 
    Dim errors as Variant 
    Dim tempint as Integer 

    Dim i as Integer 

    Try
        Error 1000, "Test Error"  ' errLine
    Catch
        Set errObj = getErrorSession().createErrorEntry(LOG_ERROR)
    End Try

    errors = getErrorSession().errors() 
    Set errObj = errObj
    Call testSuite.describe("Test error count is 1").assertEqualsInteger(1, getErrorSession().errorCount)
    Call testSuite.describe("Test error message is correct").assertEqualsString("Test Error", errObj.message, True)
    Call testSuite.describe("Test error line is correct").assertEqualsInteger(errLine, errObj.lineNum)
    Call testSuite.describe("Test error code is correct").assertEqualsInteger(1000, errObj.code)

    Dim expected as String
    expected = "Error 1000, Test Error at line " & errLine
    Call testSuite.describe("Test error message for logs").assertEqualsString(expected, errObj.getLogMessage(), True)
    Call testSuite.describe("Test script name").assertEqualsString("UNITTESTS", errObj.libraryName, True)
    Call testSuite.describe("Test method name").assertEqualsString("testErrors", errObj.methodName, True)    

    Try
        Error 1000, "Test Error"
    Catch
        Set errObj = getErrorSession().createErrorEntry(LOG_ERROR)
    End Try


    Call testSuite.describe("Test error with NO_LOGGING")
    tempint = globalLogSession.entryCount 
    Try 
        Error 1000, "Test error with NO_LOGGING"
    Catch 
        Call getErrorSession().createErrorEntry(NO_LOGGING)
        Call testSuite.addResult(True, "")
    End Try 
    Call testSuite.describe("globalLogSession.entryCount is " & tempint).assertEqualsInteger(tempint, globalLogSession.entryCount)

    Call testSuite.describe("Test error with LOG_ERROR")
    tempint = globalLogSession.entryCount + 1
    Try 
        Error 1000, "Test error with LOG_ERROR"
    Catch 
        Call getErrorSession().createErrorEntry(LOG_ERROR)
        Call testSuite.addResult(True, "")
    End Try 
    Call testSuite.describe("globalLogSession.entryCount is " & tempint).assertEqualsInteger(tempint, globalLogSession.entryCount)


    Call testSuite.describe("Test Create Custom Error Entity")
    tempint = globalLogSession.entryCount + 1
    Try 
        Error 1000, "Test Create Custom Error Entity"
    Catch 
        Call getErrorSession().createCustomErrorEntry("this is a custom error message", 1352, 2525, LOG_DEBUG)
        Call testSuite.addResult(True, "")
    End Try
    errors = getErrorSession().errors 
    Set errobj = errors(Ubound(errors))
    Call testSuite.describe("Last error message is 'this is a custom error message'").assertEqualsString("this is a custom error message", errobj.message, True)
    Call testSuite.describe("Last error code is 1352").assertEqualsInteger(1352, errobj.code)
    Call testSuite.describe("Last error line is 2525").assertEqualsInteger(2525, errobj.lineNum)
    Call testSuite.describe("globalLogSession.entryCount is " & tempint).assertEqualsInteger(tempint, globalLogSession.entryCount)


    Call testSuite.describe("Test reset error session")
    Try
        Call getErrorSession().reset()
        Call testSuite.addResult(True, "")
    Catch
        Call testSuite.addResult(False, "Error resetting error session")
    End Try
    Call testSuite.describe("Test error count is 0 after reset").assertEqualsInteger(0, getErrorSession().errorCount)
    
    Return testSuite.ranSuccessfully()

End Function


Function testClassHierarchyErrors(testRunner as TestRunner) as Boolean

    Dim baseTester as BaseErrorTester
    Dim childTester as ChildErrorTester 
    Dim ee as ErrorEntry 

    Dim testSuite as New TestSuite("Class Hierarchy Error Tests")
    Call testRunner.addTestSuite(testSuite)

    Dim errObj as ErrorEntry 
    Dim errors as Variant 
    Dim tempint as Integer 

    Set baseTester = new BaseErrorTester()
    Set childTester = new ChildErrorTester() 


    ' ERR_1100
    Call getErrorSession().reset 
    Call testSuite.describe("Test error count is 0").assertEqualsInteger(0, getErrorSession().errorCount)

    Call childTester.TryCatchError(ERR_1100, MSG_1100) 
    Call testSuite.describe("Test error count is 1").assertEqualsInteger(1, getErrorSession().errorCount)

    errors = getErrorSession().errors 
    Set ee = errors(0)
    Call testSuite.describe("Test error message is correct").assertEqualsString(MSG_1100, ee.message, True)
    Call testSuite.describe("Test error line is correct").assertEqualsInteger(ChildErrorTesterLine_1, ee.lineNum)
    Call testSuite.describe("Test error code is correct").assertEqualsInteger(ERR_1100, ee.code)
    Call testSuite.describe("Test error library is 'UnitTests'").assertEqualsString(|UnitTests|, ee.libraryName, True)
    Call testSuite.describe("Test error class is 'ChildErrorTester'").assertEqualsString(|ChildErrorTester|, ee.className, True)
    Call testSuite.describe("Test error method is 'TryCatchError'").assertEqualsString(|TryCatchError|, ee.methodName, True)


    ' ERR_1400
    Call childTester.TryCatchError(ERR_1400, MSG_1400) 
    Call testSuite.describe("Test error count is 2").assertEqualsInteger(2, getErrorSession().errorCount)

    errors = getErrorSession().errors 
    Set ee = errors(Ubound(errors))
    Call testSuite.describe("Test error message is correct").assertEqualsString(MSG_1400, ee.message, True)
    Call testSuite.describe("Test error line is correct").assertEqualsInteger(BaseErrorTesterLine, ee.lineNum)
    Call testSuite.describe("Test error code is correct").assertEqualsInteger(ERR_1400, ee.code)
    Call testSuite.describe("Test error library is 'UnitTests'").assertEqualsString(|UnitTests|, ee.libraryName, True)
    Call testSuite.describe("Test error class is 'BaseErrorTester'").assertEqualsString(|BaseErrorTester|, ee.className, True)
    Call testSuite.describe("Test error method is 'TryCatchError'").assertEqualsString(|TryCatchError|, ee.methodName, True)


    ' ERR_1600
    Call childTester.TryCatchError(ERR_1600, MSG_1600) 
    Call testSuite.describe("Test error count is 3").assertEqualsInteger(3, getErrorSession().errorCount)

    errors = getErrorSession().errors 
    Set ee = errors(Ubound(errors))
    Call testSuite.describe("Test error message is correct").assertEqualsString(MSG_1600, ee.message, True)
    Call testSuite.describe("Test error line is correct").assertEqualsInteger(ChildErrorTesterLine_2, ee.lineNum)
    Call testSuite.describe("Test error code is correct").assertEqualsInteger(ERR_1600, ee.code)
    Call testSuite.describe("Test error library is 'UnitTests'").assertEqualsString(|UnitTests|, ee.libraryName, True)
    Call testSuite.describe("Test error class is 'ChildErrorTester'").assertEqualsString(|ChildErrorTester|, ee.className, True)
    Call testSuite.describe("Test error method is 'TryCatchError'").assertEqualsString(|TryCatchError|, ee.methodName, True)


    ' ERR_1800
    Call childTester.TryCatchError(ERR_1800, MSG_1800) 
    Call testSuite.describe("Test error count is 4").assertEqualsInteger(4, getErrorSession().errorCount)

    errors = getErrorSession().errors 
    Set ee = errors(Ubound(errors))
    Call testSuite.describe("Test error message is correct").assertEqualsString(MSG_1800, ee.message, True)
    Call testSuite.describe("Test error line is correct").assertEqualsInteger(BaseErrorTesterLine, ee.lineNum)
    Call testSuite.describe("Test error code is correct").assertEqualsInteger(ERR_1800, ee.code)
    Call testSuite.describe("Test error library is 'UnitTests'").assertEqualsString(|UnitTests|, ee.libraryName, True)
    Call testSuite.describe("Test error class is 'BaseErrorTester'").assertEqualsString(|BaseErrorTester|, ee.className, True)
    Call testSuite.describe("Test error method is 'TryCatchError'").assertEqualsString(|TryCatchError|, ee.methodName, True)


    ' ERR_2100
    Call childTester.TryCatchError(ERR_2100, MSG_2100) 
    Call testSuite.describe("Test error count is 5").assertEqualsInteger(5, getErrorSession().errorCount)

    errors = getErrorSession().errors 
    Set ee = errors(Ubound(errors))
    Call testSuite.describe("Test error message is correct").assertEqualsString(MSG_2100, ee.message, True)
    Call testSuite.describe("Test error line is correct").assertEqualsInteger(ChildErrorTesterLine_3, ee.lineNum)
    Call testSuite.describe("Test error code is correct").assertEqualsInteger(ERR_2100, ee.code)
    Call testSuite.describe("Test error library is 'UnitTests'").assertEqualsString(|UnitTests|, ee.libraryName, True)
    Call testSuite.describe("Test error class is 'ChildErrorTester'").assertEqualsString(|ChildErrorTester|, ee.className, True)
    Call testSuite.describe("Test error method is 'TryCatchError'").assertEqualsString(|TryCatchError|, ee.methodName, True)

    Return testSuite.ranSuccessfully()

End Function


Function testSpawnedLogEntryProperties(testRunner as TestRunner) As Boolean 
    Dim baseTester as BaseErrorTester
    Dim ee as ErrorEntry 
    Dim le as LogEntry 

    Dim testSuite as New TestSuite("Spawned LogEntry Property Tests")
    Call testRunner.addTestSuite(testSuite)

    Dim errors as Variant 
    Dim tempint as Integer 

    Set baseTester = new BaseErrorTester()


    ' Reset the error session and log session objects
    Call getErrorSession().reset() 
    Call globalLogSession.reset() 

    ' ERR_1100
    Call baseTester.TryCatchError(ERR_1100, MSG_1100) 
    Call testSuite.describe("Test error count is 1").assertEqualsInteger(1, getErrorSession().errorCount)

    errors = getErrorSession().errors 
    Set ee = errors(Ubound(errors))
    Set le = globalLogSession.lastEntry 

    Call ee.printSummary() 
    Call le.printSummary() 

    Call testSuite.describe("Test error message is correct").assertEqualsString(MSG_1100, ee.message, True)
    Call testSuite.describe("Test error line is correct").assertEqualsInteger(BaseErrorTesterLine, ee.lineNum)
    Call testSuite.describe("Test error code is correct").assertEqualsInteger(ERR_1100, ee.code)
    Call testSuite.describe("Test error library is 'UnitTests'").assertEqualsString(|UnitTests|, ee.libraryName, True)
    Call testSuite.describe("Test error class is 'BaseErrorTester'").assertEqualsString(|BaseErrorTester|, ee.className, True)
    Call testSuite.describe("Test error method is 'TryCatchError'").assertEqualsString(|TryCatchError|, ee.methodName, True)
    
    Call testSuite.describe("Log message matches LogMessage").assertEqualsString(ee.getLogMessage, le.message, True) 
    Call testSuite.describe("Log libraryName matches error libraryName").assertEqualsString(ee.libraryName, le.libraryName, True) 
    Call testSuite.describe("Log className matches error className").assertEqualsString(ee.className, le.className, True) 
    Call testSuite.describe("Log methodName matches error methodName").assertEqualsString(ee.methodName, le.methodName, True) 
    Call testSuite.describe("Log stackTrace matches error stackTrace").assertEqualsString(ee.stackTrace, le.stackTrace, True) 
    Call testSuite.describe("Log linenum is correct").assertEqualsInteger(BaseErrorTesterLine + 2, le.lineNum) 

    Return testSuite.ranSuccessfully()

End Function 


Function runSessionTests(testRunner as TestRunner) as Boolean

    Dim testSuite as New TestSuite("Session Tests")
    Call testRunner.addTestSuite(testSuite)

    Call testSuite.describe("Test getting session").assertIs("LOGSESSION", globalLogSession)
    Call testSuite.describe("Test session id is not empty").assertNotEqualString("", globalLogSession.SessionId)
    Call testSuite.describe("Test last entry is nothing").assertTrue(globalLogSession.LastEntry Is Nothing)
    Call testSuite.describe("Test log entries count is 0").assertEqualsInteger(0, globalLogSession.entryCount)
    Call testSuite.describe("Test creating new session throws error")
    Try
        Execute |Dim foo as New LogSession()|
        Call testSuite.addResult(False, "Creating new session did not throw error")
    Catch
        Call testSuite.addResult(True, "")
        Call testSuite.describe("Test error was 156").assertEqualsInteger(156, Err())
        Call testSuite.describe("Test error message was correct").assertEqualsString("Operation Prohibited. Use globalLogSession to get the LogSession object.  ", StrRight(Error(), ": "), True)
    End Try
    
    Dim currId as String
    currId = globalLogSession.SessionId
    Call globalLogSession.reset()
    Call testSuite.describe("Test session id is different after reset").assertNotEqualString(currId, globalLogSession.SessionId)

    Return testSuite.ranSuccessfully()

End Function

Function logEntryTests(testRunner as TestRunner) as Boolean
    ' Create a testSuite called "Log Entry Tests"
    Dim logEntrySuite as New TestSuite("Log Entry Tests")
    Dim foo as LogEntry
    Dim bar as LogEntry

    Call testRunner.addTestSuite(logEntrySuite)
    Call logEntrySuite.describe("Test creating new log entry without args throws error")
    Try
        Execute |Set foo = New LogEntry()|
        Call logEntrySuite.addResult(False, "Creating new log entry did not throw error")
    Catch
        Call logEntrySuite.addResult(True, "")
        Call logEntrySuite.describe("Test error was 156").assertEqualsInteger(156, Err())
        Call logEntrySuite.describe("Test error message was correct").assertEqualsString("$EXECUTE$+1: Missing argument to constructor for: LOGENTRY", Error(), True)
    End Try

    Call logEntrySuite.describe("Test creating new log entry with invalid level throws error")
    Try
        Execute |Set foo = New LogEntry(400, "Test Log Entry", "Some extended information", Nothing)|
        Call logEntrySuite.addResult(False, "Creating new log entry did not throw error")
    Catch
        Call logEntrySuite.addResult(True, "")
        Call logEntrySuite.describe("Test error with bad level was 156").assertEqualsInteger(156, Err())
        Call logEntrySuite.describe("Test error message with bad level was correct").assertTrue(Instr(Error(), "Invalid Log Level (400)") > 0)
    End Try

    Dim timestamp as String
    timestamp = Format(Now, "yyyy-mm-dd hh:MM:ss")
    Set foo = globalLogSession.createLogEntry(LOG_FATAL, "Test Log Entry", "Some extended information", Nothing)
    Call logEntrySuite.describe("Test log entry message").assertEqualsString("Test Log Entry", foo.Message, True)
    Call logEntrySuite.describe("Test log entry timestamp").assertNotEqualString("", foo.Timestamp)
    Call logEntrySuite.describe("Test log entry timestamp matches now").assertEqualsString(Left(timestamp, 14), Left(foo.Timestamp,14), True)
    Call logEntrySuite.describe("Test libraryname UNITTESTS").assertEqualsString(GetThreadInfo(2), foo.libraryName, True)
    Call logEntrySuite.describe("Test log entry ID").assertNotEqualString("", foo.entryID)
    Call logEntrySuite.describe("Test log entry ID starts with " & GetThreadInfo(2)).assertEqualsString(GetThreadInfo(2), Left(foo.entryID, 9), True)
    Call logEntrySuite.describe("Test log entry level").assertEqualsInteger(LOG_FATAL, foo.Level)
    Call logEntrySuite.describe("Test log entry extended info").assertEqualsString("Some extended information", foo.extInfo, True)
    Call logEntrySuite.describe("Test log entry className").assertEqualsString("", foo.className, True)
    Call logEntrySuite.describe("Log linenum is correct").assertEqualsInteger(452, foo.lineNum) 

    ' Reset the global log session before continuing 
    Call globalLogSession.reset() 
    Set foo = globalLogSession.createLogEntry(LOG_FATAL, "Test Log Entry", "Some extended information", Nothing)

    ' bar is the last entry created in the session
    Set bar = globalLogSession.createLogEntry(LOG_FATAL, "Test Log Entry", "Some extended information", Nothing)

    Call logEntrySuite.describe("Test foo and bar entry ids different").assertNotEqualString(foo.entryID, bar.entryID)
    Call logEntrySuite.describe("Check level set correctly").assertEqualsInteger(LOG_FATAL, foo.level)
    Call logEntrySuite.describe("Check two entries").assertEqualsInteger(2, globalLogSession.entryCount)

    Call logEntrySuite.describe("Check bar ID = second ID").assertEqualsString(bar.entryID, globalLogSession.entryIDs(1), True)
    Call logEntrySuite.describe("Check bar levelname").assertEqualsString("FATAL", bar.levelName, True)
    Call logEntrySuite.describe("Check bar is the LastEntry").assertEqualsString(bar.entryID, globalLogSession.lastEntry.entryID, True)

    Dim id as String
    id = bar.entryID
    Set bar = Nothing
    Set bar = globalLogSession.getLogEntryById(id)
    Call logEntrySuite.describe("Check retrieving by ID works").assertFalse(bar Is Nothing)
    If bar is Nothing Then Exit Function
    Call logEntrySuite.describe("Check level when retrieving bar by ID").assertEqualsInteger(LOG_FATAL, bar.level)

    id = globalLogSession.entryIDs(1) 
    Call logEntrySuite.describe("Check retrieving second ID is not Blank").assertNotEqualString("", id)
    Call logEntrySuite.describe("Check retrieved second ID = bar ID").assertEqualsString(id, bar.entryID, True) 

    Set bar = globalLogSession.getLogEntryById(id)
    Call logEntrySuite.describe("Check level after retrieving bar by ID").assertEqualsInteger(LOG_FATAL, bar.level)

    Call globalLogSession.reset()
    Call logEntrySuite.describe("Check log entries cleared").assertEqualsInteger(0, globalLogSession.entryCount)
    Return logEntrySuite.ranSuccessfully()
End Function

Function logCollectionTests(testRunner as TestRunner) as Boolean
    ' Create a testSuite called "Log Collection Tests"
    Dim logCollectionSuite as New TestSuite("Log Collection Tests")
    Call testRunner.addTestSuite(logCollectionSuite)

    Dim temp as LogEntry
    Set temp = globalLogSession.createLogEntry(LOG_FATAL, "Test Log Entry", "Some extended information", Nothing)
    Call logCollectionSuite.describe("Test log entries count is 1").assertEqualsInteger(1, globalLogSession.entryCount)
    Call globalLogSession.createLogEntry(LOG_FATAL, "Test Log Entry", "Some extended information", Nothing)
    Call globalLogSession.createLogEntry(LOG_FATAL, "Test Log Entry 2", "Some extended information", Nothing)
    Call globalLogSession.createLogEntry(LOG_INFO, "Test Log Entry 3", "Some extended information", Nothing)
    Call logCollectionSuite.describe("Test log entries count is 4").assertEqualsInteger(4, globalLogSession.entryCount)

    Dim tempColl as Variant
    tempColl = globalLogSession.getLogEntriesByLevel(LOG_FATAL, LOG_FATAL)
    Call logCollectionSuite.describe("Test log fatal entries count is 1").assertEqualsLong(2, UBound(tempColl))
    tempColl = globalLogSession.getLogEntriesByLevel(LOG_INFO, LOG_INFO)
    Call logCollectionSuite.describe("Test log info entries count is 1").assertEqualsLong(0, UBound(tempColl))
    tempColl = globalLogSession.getLogEntriesByLevel(LOG_DEBUG, LOG_DEBUG)
    Call logCollectionSuite.describe("Test log debug entries count is 0").assertTrue(IsEmpty(tempColl))
    Call globalLogSession.reset()
    
    Return logCollectionSuite.ranSuccessfully()
End Function

Function logFunctionTests(testRunner as TestRunner) as Boolean
    ' Create a testSuite called "Log Function Tests"
    Dim logFunctionSuite as New TestSuite("Log Function Tests")
    Call testRunner.addTestSuite(logFunctionSuite)

    %REM This test removed because getLogEntryPropertyNames() method is no longer a global public method.
    Call logFunctionSuite.describe("Test LogEntry Property Names elements").assertEqualsLong(10, UBound(getLogEntryPropertyNames()))
    %END REM 

    Dim i as Integer
    Dim prop as String
    Dim logEntry as LogEntry

    Set logEntry = globalLogSession.createLogEntry(LOG_FATAL, "Test Log Entry", "Some extended information", Nothing)

    %REM This test removed because getLogEntryPropertyNames() method is no longer a global public method.
    For i = 0 To UBound(getLogEntryPropertyNames())
        prop = getLogEntryPropertyNames()(i)
        Select Case prop 
            Case |CLASSNAME|: 
                Call logFunctionSuite.describe("Test property " & prop & " is blank").assertEqualsString("", Cstr(logEntry.getPropertyValue(prop)), False)

            Case Else 
                Call logFunctionSuite.describe("Test property " & prop & " is not empty").assertNotEqualString("", CStr(logEntry.getPropertyValue(prop)))
        End Select 
    Next
    %END REM 

    Try
        Call logFunctionSuite.describe("Test getPropertyValue throws error with bad property")
        Call logEntry.getPropertyValue("BADPROPERTY")
        Call logFunctionSuite.addResult(False, "getPropertyValue did not throw error")
    Catch
        Call logFunctionSuite.addResult(True, "")
        Call LogFunctionSuite.describe("Test error was 1195").assertEqualsInteger(1195, Err())
        Call logFunctionSuite.describe("Test error message was correct").assertEqualsString("A passed parameter is invalid.  propertyName: BADPROPERTY", Error(), True)
    End Try

    Return logFunctionSuite.ranSuccessfully()
End Function

Function runBaseWriterTests(testRunner as testRunner) as Boolean

    Dim baseWriterSuite as New TestSuite("Base Writer Tests")
    Call testRunner.addTestSuite(baseWriterSuite)

    Dim formatter as String
    Dim actual as String
    Dim expected as String
    Dim success as Boolean
    formatter = "{{LEVELNAME}}: {{TIMESTAMP}} - {{MESSAGE}} - {{EXTINFO}}"
    Dim baseWriter as New TestLogWriter("Base Test Writer", LOG_TRACE, LOG_FATAL, formatter)

    Dim logEntry as LogEntry 
    Set logEntry = globalLogSession.createLogEntry(LOG_FATAL, "Test Log Entry", "Some extended information", Nothing)
    expected = "FATAL: " & logEntry.Timestamp & " - Test Log Entry - Some extended information"
    
    Call baseWriterSuite.describe("Test base writer label").assertEqualsString("Base Test Writer", baseWriter.label, True)
    Call baseWriterSuite.describe("Test base writer max level").assertEqualsInteger(LOG_FATAL, baseWriter.maxLevel)
    Call baseWriterSuite.describe("Test base writer formatter").assertEqualsString(formatter, baseWriter.formatter, True)

    Call baseWriterSuite.describe("Test base writer format string")
    Try
        actual = baseWriter.TestLogEntryFormat(logEntry)
        Call baseWriterSuite.addResult(True, "")
    Catch
        Call baseWriterSuite.addError("Error formatting log entry: " & Error(), GetThreadInfo(12))
    End Try
    Call baseWriterSuite.describe("Test formatted string").assertEqualsString(expected, actual, True)

    Set baseWriter = New TestLogWriter("Base Test Writer Empty", LOG_TRACE, LOG_TRACE, "{{LEVELNAME}}: {{MESSAGE}}") 
    Call globalLogSession.reset()
    Call baseWriterSuite.describe("Test log writer output when empty").assertFalse(baseWriter.writeToLog(globalLogSession))
    Call baseWriterSuite.describe("Test output coll is nothing").assertEqualsLong(0, UBound(baseWriter.outputColl))

    Set baseWriter = New TestLogWriter("Base Test Writer Fatal", LOG_TRACE, LOG_FATAL, "{{LEVELNAME}}: {{MESSAGE}}")
    Call preSeedSession(baseWriter)
    Call baseWriterSuite.describe("Test log writer added to session").assertTrue(IsElement(globalLogSession.logWriters(baseWriter.label)))
    Call baseWriterSuite.describe("Test log writer output").assertTrue(baseWriter.writeToLog(globalLogSession))
    Call baseWriterSuite.describe("Test log writer output count is 6").assertEqualsLong(5, UBound(baseWriter.outputColl))

    Set baseWriter = New TestLogWriter("Base Test Writer Trace", LOG_TRACE, LOG_TRACE, "{{LEVELNAME}}: {{MESSAGE}}")
    Call preSeedSession(baseWriter)
    Call baseWriter.writeToLog(globalLogSession)
    Call baseWriterSuite.describe("Test log writer output count is 1").assertEqualsLong(0, UBound(baseWriter.outputColl))
    
    Set baseWriter = New TestLogWriter("Base Test Writer Error to Fatal", LOG_ERROR, LOG_FATAL, "{{LEVELNAME}}: {{MESSAGE}}")
    Call preSeedSession(baseWriter)
    Call baseWriter.writeToLog(globalLogSession)
    Call baseWriterSuite.describe("Test log writer output count is 2").assertEqualsLong(1, UBound(baseWriter.outputColl))

    Return baseWriterSuite.ranSuccessfully()

End Function 




Private Sub preSeedSession(baseWriter as BaseLogWriter)
    Call globalLogSession.reset()
    Call globalLogSession.addLogWriter(baseWriter)
    Call globalLogSession.createLogEntry(LOG_FATAL, "Test Fatal Log Entry", "", Nothing)
    Call globalLogSession.createLogEntry(LOG_ERROR, "Test Error Log Entry", "", Nothing)
    Call globalLogSession.createLogEntry(LOG_WARN, "Test Warn Log Entry", "", Nothing)
    Call globalLogSession.createLogEntry(LOG_INFO, "Test Info Log Entry", "", Nothing)
    Call globalLogSession.createLogEntry(LOG_DEBUG, "Test Debug Log Entry", "", Nothing)
    Call globalLogSession.createLogEntry(LOG_TRACE, "Test Trace Log Entry", "", Nothing)
End Sub